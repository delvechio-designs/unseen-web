# Copy to .env.local for development. Set the same keys in Vercel for production.
# Use the DEVELOPMENT Supabase project locally and the PRODUCTION project on Vercel.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test keys locally). Create two monthly recurring prices and paste their IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Postmark
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=hello@yourdomain.com      # creator-facing email
NOTICE_FROM_EMAIL=takedowns@yourdomain.com    # sender for DMCA notices; must accept replies
ADMIN_NOTIFY_EMAIL=

# Agent details printed on every DMCA notice (Unseen's details, NOT the creator's)
AGENT_NAME=
AGENT_ADDRESS=
AGENT_PHONE=

# Internal admin routes (/api/admin/*). Random string, 24+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
